# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=generate-a-random-32-char-string
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=code-review-agent
# Optional: override for testing against a mock (default https://api.github.com)
# GITHUB_API_URL=https://api.github.com

# Hindsight
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_xxxxxxxxxxxx
HINDSIGHT_BANK_ID=code-review-agent-bank

# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
# Optional: override for testing against a mock (default https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Server
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Tuning (optional)
# MAX_DIFF_CHARS=8000
# MEMORY_CONFIDENCE_THRESHOLD=0.7
