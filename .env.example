# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=generate-a-random-32-char-string
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=code-review-agent
# Optional: override for testing against a mock (default https://api.github.com)
# GITHUB_API_URL=https://api.github.com

# Hindsight
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_xxxxxxxxxxxx
HINDSIGHT_BANK_ID=code-review-agent-bank

# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
# Optional: override for testing against a mock.
# NOTE: groq-sdk appends /openai/v1 itself — do not include it in this value.
# GROQ_BASE_URL=https://api.groq.com
# Optional: comma-separated model fallback chain used when the primary model
# hits Groq rate limits (free tier per model: 30 RPM / 1K RPD / 8K TPM / 200K TPD).
# Default chain: openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Server
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Tuning (optional)
# MAX_DIFF_CHARS=8000
# MEMORY_CONFIDENCE_THRESHOLD=0.7

# Optional: Postgres (e.g. Neon) — persistent webhook dedupe, Hindsight recall
# caching (cuts LLM-backed recall calls) and local review/learning audit trail.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# RECALL_CACHE_TTL_SEC=3600
